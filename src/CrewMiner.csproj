<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>CrewMiner</AssemblyName><Version>0.1.0</Version><Deterministic>true</Deterministic>
    <GamePlatform Condition="'$(GamePlatform)' == ''">Windows</GamePlatform>
    <RefsDir Condition="'$(RefsDir)' == ''">../Refs</RefsDir>
    <DefineConstants>CLIENT</DefineConstants><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);MSB3270</NoWarn><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Reference Include="Barotrauma"><HintPath>$(RefsDir)/$(GamePlatform)/Barotrauma.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BarotraumaCore"><HintPath>$(RefsDir)/$(GamePlatform)/BarotraumaCore.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MonoGame.Framework.$(GamePlatform).NetStandard"><HintPath>$(RefsDir)/MonoGame.Framework.$(GamePlatform).NetStandard.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Farseer.NetStandard"><HintPath>$(RefsDir)/Farseer.NetStandard.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="XNATypes"><HintPath>$(RefsDir)/XNATypes.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(RefsDir)/0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(GamePlatform)' == 'OSX'">
    <Reference Remove="MonoGame.Framework.OSX.NetStandard" />
    <Reference Include="MonoGame.Framework.MacOS.NetStandard"><HintPath>$(RefsDir)/MonoGame.Framework.MacOS.NetStandard.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
